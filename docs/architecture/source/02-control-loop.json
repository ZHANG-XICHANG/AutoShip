  "cards": [
    {
      "dot": "emerald",
      "title": "LOS 導引",
      "items": [
        "船位投影到目前航段，再沿航段前推 los_look_ahead_m（設定 8 m）作為瞄準點",
        "前視距離上限為航段長度的一半",
        "到點：在 reach_radius_m 內連續 required_inside_count 次，或已越過航點垂直面"
      ]
    },
    {
      "dot": "cyan",
      "title": "PID 與差速分配",
      "items": [
        "PID 單位為 PWM µs；設定 KP=10、KI=0、KD=8，死區 ±5°",
        "差值限幅 ±400 µs：左 = 基礎 + 差值、右 = 基礎 − 差值",
        "左右再限制於 1500–2000 µs（min_thruster_pwm = 1500，預設不倒轉）"
      ]
    },
    {
      "dot": "amber",
      "title": "基礎推力",
      "items": [
        "巡航 1700 µs；航向誤差 > 10° 時改用 1600 µs",
        "僅最後一個航點在 10 m 內線性降到 1600 µs"
      ]
    },
    {
      "dot": "slate",
      "title": "閱讀說明",
      "items": [
        "模擬模式下，感測資料處理以指令 PWM 推算位置與航向後替換原始值",
        "數值取自 commit 6e0cef6 的 config/settings.json"
      ]
    }
  ]
